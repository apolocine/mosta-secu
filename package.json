{
  "name": "@mostajs/secu",
  "version": "1.0.16",
  "description": "Client access control, lockers, RFID tags — reusable security module for @mostajs ecosystem",
  "author": "Dr Hamid MADANI <drmdh@msn.com>",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./api/*": {
      "types": "./dist/api/*.d.ts",
      "import": "./dist/api/*.js",
      "default": "./dist/api/*.js"
    },
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js",
      "default": "./dist/components/*.js"
    },
    "./lib/menu": {
      "types": "./dist/lib/menu.d.ts",
      "import": "./dist/lib/menu.js",
      "default": "./dist/lib/menu.js"
    },
    "./lib/permissions": {
      "types": "./dist/lib/permissions.d.ts",
      "import": "./dist/lib/permissions.js",
      "default": "./dist/lib/permissions.js"
    },
    "./lib/seeds": {
      "types": "./dist/lib/seeds.d.ts",
      "import": "./dist/lib/seeds.js",
      "default": "./dist/lib/seeds.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js",
      "default": "./dist/types/index.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "import": "./dist/register.js",
      "default": "./dist/register.js"
    },
    "./i18n/*": "./i18n/*"
  },
  "files": [
    "dist",
    "i18n",
    "seeds",
    "wire.json",
    "secu.wire.json",
    "LICENSE",
    "README.md",
    "llms.txt"
  ],
  "keywords": [
    "access-control",
    "client-management",
    "lockers",
    "rfid",
    "qr-code",
    "security",
    "nextjs",
    "mosta"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/apolocine/mosta-secu"
  },
  "homepage": "https://mostajs.dev/packages/secu",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@mostajs/octoswitcher": "^1.0.0",
    "@mostajs/orm": "^1.4.0"
  },
  "peerDependencies": {
    "@mostajs/audit": ">=1.0.0",
    "@mostajs/menu": ">=1.0.0",
    "@mostajs/settings": ">=1.0.0",
    "@mostajs/socle": ">=2.0.0",
    "@mostajs/ticketing": ">=3.0.0",
    "@mostajs/ui": ">=1.0.0",
    "@tanstack/react-query": ">=5.0.0",
    "lucide-react": ">=0.400.0",
    "next": ">=14",
    "react": ">=18",
    "sonner": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "@mostajs/menu": {
      "optional": true
    },
    "@mostajs/ticketing": {
      "optional": true
    },
    "@mostajs/audit": {
      "optional": true
    },
    "@mostajs/settings": {
      "optional": true
    },
    "@mostajs/ui": {
      "optional": true
    },
    "@tanstack/react-query": {
      "optional": true
    },
    "lucide-react": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "sonner": {
      "optional": true
    }
  },
  "devDependencies": {
    "@mostajs/audit": "^1.0.3",
    "@mostajs/menu": "^1.0.2",
    "@mostajs/settings": "^1.0.5",
    "@mostajs/socle": "^2.0.0",
    "@mostajs/ticketing": "^3.0.1",
    "@mostajs/ui": "^1.0.3",
    "@tanstack/react-query": "^5.0.0",
    "@types/node": "^25.3.3",
    "@types/react": "^19.2.14",
    "lucide-react": "^0.460.0",
    "next": "^16.1.6",
    "react": "^19.0.0",
    "sonner": "^1.0.0",
    "typescript": "^5.6.0"
  }
}
